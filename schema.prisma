generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())

  reviews   Review[]

  @@map("users")
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  books Book[]

  @@map("genres")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  isbn        String   @unique
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  reviews Review[]

  @@index([genreId])
  @@map("books")
}

// Stretch: Review model
model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1..5 (validate in app layer)
  comment   String?
  createdAt DateTime @default(now())

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])   // one review per user per book
  @@map("reviews")
}